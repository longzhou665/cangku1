# 默认使用 providers/mock-chat.js，无需 Key，可本地/CI 演示。
# 对接真实对话产品时：把 promptfooconfig.yaml 里的 provider 换成下方之一，并填入密钥。

# OpenAI 兼容接口（含多数国内中转 / 自建网关）
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini

# 若使用 Anthropic
# ANTHROPIC_API_KEY=

# 评测报告元数据（写入基线报告）
EVAL_PRODUCT_NAME=星河助手
EVAL_ENV=sandbox
EVAL_BASELINE_ID=BL-YYYYMMDD-01
